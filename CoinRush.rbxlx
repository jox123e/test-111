<Item class="ReplicatedStorage" referent="RBX58"><Properties>
<string name="Name">ReplicatedStorage</string>
</Properties>
<Item class="ModuleScript" referent="RBX59"><Properties>
<string name="Name">GameConfig</string>
<ProtectedString name="Source"><![CDATA[local Config = {}

Config.GameName = "Coin Rush"
Config.CoinValue = 1
Config.RespawnTime = 3
Config.WinBonus = 25
Config.FallY = -50

function Config.formatCoins(n)
	return string.format("%d coin%s", n, n == 1 and "" or "s")
end

return Config
]]></ProtectedString>
</Properties></Item>
<Item class="RemoteEvent" referent="RBX60"><Properties><string name="Name">CoinCollected</string></Properties></Item>
</Item>
<Item class="ServerScriptService" referent="RBX61"><Properties>
<string name="Name">ServerScriptService</string>
</Properties><Item class="Script" referent="RBX62"><Properties>
<string name="Name">GameManager</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("GameConfig"))
local coinEvent = ReplicatedStorage:WaitForChild("CoinCollected")

local debounce = {}

local function setupPlayer(player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	stats.Parent = player

	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Value = 0
	coins.Parent = stats

	local deaths = Instance.new("IntValue")
	deaths.Name = "Deaths"
	deaths.Value = 0
	deaths.Parent = stats

	player.CharacterAdded:Connect(function(char)
		local hum = char:WaitForChild("Humanoid")
		hum.Died:Connect(function()
			deaths.Value += 1
		end)
		task.spawn(function()
			while char.Parent and hum.Health > 0 do
				local root = char:FindFirstChild("HumanoidRootPart")
				if root and root.Position.Y < Config.FallY then
					hum.Health = 0
				end
				task.wait(0.5)
			end
		end)
	end)
end

local function getPlayerFromHit(hit)
	local char = hit:FindFirstAncestorOfClass("Model")
	return char and Players:GetPlayerFromCharacter(char), char
end

-- Monedas
for _, coin in ipairs(workspace.Coins:GetChildren()) do
	coin.Touched:Connect(function(hit)
		local player = getPlayerFromHit(hit)
		if not player or coin.Transparency >= 1 then return end

		coin.Transparency = 1
		player.leaderstats.Coins.Value += Config.CoinValue
		coinEvent:FireClient(player, player.leaderstats.Coins.Value)

		task.delay(Config.RespawnTime * 5, function()
			coin.Transparency = 0
		end)
	end)

	-- girar la moneda
	task.spawn(function()
		while coin.Parent do
			coin.CFrame = coin.CFrame * CFrame.Angles(0, math.rad(4), 0)
			task.wait(1 / 30)
		end
	end)
end

-- Lava
for _, brick in ipairs(workspace.Lava:GetChildren()) do
	brick.Touched:Connect(function(hit)
		local player, char = getPlayerFromHit(hit)
		if player and char then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum then hum.Health = 0 end
		end
	end)
end

-- Meta
workspace.Goal.Touched:Connect(function(hit)
	local player = getPlayerFromHit(hit)
	if player and not debounce[player] then
		debounce[player] = true
		player.leaderstats.Coins.Value += Config.WinBonus
		coinEvent:FireClient(player, player.leaderstats.Coins.Value)
		task.delay(10, function() debounce[player] = nil end)
	end
end)

Players.PlayerAdded:Connect(setupPlayer)
for _, p in ipairs(Players:GetPlayers()) do
	setupPlayer(p)
end

print(Config.GameName .. " listo!")
]]></ProtectedString>
</Properties></Item></Item>
<Item class="StarterPlayer" referent="RBX63"><Properties>
<string name="Name">StarterPlayer</string>
</Properties>
<Item class="StarterPlayerScripts" referent="RBX64"><Properties>
<string name="Name">StarterPlayerScripts</string>
</Properties><Item class="LocalScript" referent="RBX65"><Properties>
<string name="Name">HUD</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("GameConfig"))
local coinEvent = ReplicatedStorage:WaitForChild("CoinCollected")

local player = Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Name = "HUD"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local label = Instance.new("TextLabel")
label.Size = UDim2.new(0, 260, 0, 50)
label.Position = UDim2.new(0.5, -130, 0, 10)
label.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
label.BackgroundTransparency = 0.3
label.TextColor3 = Color3.fromRGB(255, 215, 0)
label.Font = Enum.Font.GothamBold
label.TextSize = 24
label.Text = Config.GameName .. ": 0 coins"
label.Parent = gui

coinEvent.OnClientEvent:Connect(function(total)
	label.Text = Config.GameName .. ": " .. Config.formatCoins(total)
	local tween = TweenService:Create(label, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = UDim2.new(0, 290, 0, 58)
	})
	tween:Play()
	tween.Completed:Wait()
	TweenService:Create(label, TweenInfo.new(0.15), {Size = UDim2.new(0, 260, 0, 50)}):Play()
end)
]]></ProtectedString>
</Properties></Item></Item>
</Item>
</roblox>
