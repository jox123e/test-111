<Item class="ReplicatedStorage" referent="RBX190"><Properties>
<string name="Name">ReplicatedStorage</string>
</Properties>
<Item class="ModuleScript" referent="RBX191"><Properties>
<string name="Name">RagdollConfig</string>
<ProtectedString name="Source"><![CDATA[local Config = {
	ImpactThreshold = 65, -- cambio de velocidad por frame que dispara ragdoll
	RecoverTime = 3,
	DefaultLimits = {Upper = 45, TwistLower = -30, TwistUpper = 30},
	Limits = {
		-- R6
		Neck = {Upper = 40, TwistLower = -40, TwistUpper = 40},
		["Left Shoulder"] = {Upper = 100, TwistLower = -45, TwistUpper = 45},
		["Right Shoulder"] = {Upper = 100, TwistLower = -45, TwistUpper = 45},
		["Left Hip"] = {Upper = 70, TwistLower = -30, TwistUpper = 30},
		["Right Hip"] = {Upper = 70, TwistLower = -30, TwistUpper = 30},
		-- R15
		Waist = {Upper = 25, TwistLower = -20, TwistUpper = 20},
		LeftShoulder = {Upper = 100, TwistLower = -45, TwistUpper = 45},
		RightShoulder = {Upper = 100, TwistLower = -45, TwistUpper = 45},
		LeftElbow = {Upper = 70, TwistLower = -10, TwistUpper = 10},
		RightElbow = {Upper = 70, TwistLower = -10, TwistUpper = 10},
		LeftWrist = {Upper = 30, TwistLower = -20, TwistUpper = 20},
		RightWrist = {Upper = 30, TwistLower = -20, TwistUpper = 20},
		LeftHip = {Upper = 70, TwistLower = -30, TwistUpper = 30},
		RightHip = {Upper = 70, TwistLower = -30, TwistUpper = 30},
		LeftKnee = {Upper = 60, TwistLower = -5, TwistUpper = 5},
		RightKnee = {Upper = 60, TwistLower = -5, TwistUpper = 5},
		LeftAnkle = {Upper = 25, TwistLower = -10, TwistUpper = 10},
		RightAnkle = {Upper = 25, TwistLower = -10, TwistUpper = 10},
	},
}

return Config
]]></ProtectedString>
</Properties></Item>
<Item class="RemoteEvent" referent="RBX192"><Properties><string name="Name">ToggleRagdoll</string></Properties></Item>
</Item>
<Item class="ServerScriptService" referent="RBX193"><Properties>
<string name="Name">ServerScriptService</string>
</Properties>
<Item class="ModuleScript" referent="RBX194"><Properties>
<string name="Name">RagdollService</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("RagdollConfig"))

local Ragdoll = {}

-- character -> {objects = {...}, motors = {...}, untilTime = number}
local active = setmetatable({}, {__mode = "k"})

local function setFlag(character, value)
	local player = Players:GetPlayerFromCharacter(character)
	if player then
		player:SetAttribute("Ragdolled", value)
	end
end

local function buildJoint(motor, data)
	local part0, part1 = motor.Part0, motor.Part1

	local a0 = Instance.new("Attachment")
	a0.Name = "RagdollAttachment0"
	a0.CFrame = motor.C0
	a0.Parent = part0

	local a1 = Instance.new("Attachment")
	a1.Name = "RagdollAttachment1"
	a1.CFrame = motor.C1
	a1.Parent = part1

	local limits = Config.Limits[motor.Name] or Config.DefaultLimits

	local socket = Instance.new("BallSocketConstraint")
	socket.Name = "RagdollSocket"
	socket.Attachment0 = a0
	socket.Attachment1 = a1
	socket.LimitsEnabled = true
	socket.UpperAngle = limits.Upper
	socket.TwistLimitsEnabled = true
	socket.TwistLowerAngle = limits.TwistLower
	socket.TwistUpperAngle = limits.TwistUpper
	socket.Parent = part0

	local noCollide = Instance.new("NoCollisionConstraint")
	noCollide.Name = "RagdollNoCollide"
	noCollide.Part0 = part0
	noCollide.Part1 = part1
	noCollide.Parent = part0

	table.insert(data.objects, a0)
	table.insert(data.objects, a1)
	table.insert(data.objects, socket)
	table.insert(data.objects, noCollide)
end

function Ragdoll.isRagdolled(character)
	return active[character] ~= nil
end

function Ragdoll.enable(character)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or active[character] then
		return
	end

	local data = {objects = {}, motors = {}, untilTime = math.huge}
	active[character] = data

	if humanoid.Health > 0 then
		humanoid.PlatformStand = true
		humanoid.AutoRotate = false
		humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	end

	for _, descendant in ipairs(character:GetDescendants()) do
		if descendant:IsA("Motor6D") and descendant.Enabled
			and descendant.Part0 and descendant.Part1
			and descendant.Part0.Name ~= "HumanoidRootPart" then
			buildJoint(descendant, data)
			descendant.Enabled = false
			table.insert(data.motors, descendant)
		end
	end

	setFlag(character, true)
end

function Ragdoll.disable(character)
	local data = active[character]
	if not data then
		return
	end
	active[character] = nil

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")

	-- enderezar antes de reactivar los Motor6D para evitar el "pop"
	if root and humanoid and humanoid.Health > 0 then
		local _, yaw, _ = root.CFrame:ToEulerAnglesYXZ()
		root.CFrame = CFrame.new(root.Position + Vector3.new(0, 3, 0)) * CFrame.Angles(0, yaw, 0)
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end

	for _, obj in ipairs(data.objects) do
		obj:Destroy()
	end
	for _, motor in ipairs(data.motors) do
		if motor.Parent then
			motor.Enabled = true
		end
	end

	if humanoid and humanoid.Health > 0 then
		humanoid.PlatformStand = false
		humanoid.AutoRotate = true
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	end

	setFlag(character, false)
end

function Ragdoll.ragdollFor(character, seconds)
	Ragdoll.enable(character)
	local data = active[character]
	if not data then
		return
	end

	data.untilTime = os.clock() + seconds
	task.delay(seconds, function()
		local current = active[character]
		if current and current == data and os.clock() >= data.untilTime - 0.05 then
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if character.Parent and humanoid and humanoid.Health > 0 then
				Ragdoll.disable(character)
			end
		end
	end)
end

return Ragdoll
]]></ProtectedString>
</Properties></Item>
<Item class="Script" referent="RBX195"><Properties>
<string name="Name">RagdollController</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Ragdoll = require(script.Parent:WaitForChild("RagdollService"))
local Config = require(ReplicatedStorage:WaitForChild("RagdollConfig"))
local toggleEvent = ReplicatedStorage:WaitForChild("ToggleRagdoll")

local lastToggle = {}

local function onCharacter(player, character)
	local humanoid = character:WaitForChild("Humanoid")
	local root = character:WaitForChild("HumanoidRootPart")

	humanoid.BreakJointsOnDeath = false
	humanoid.RequiresNeck = false
	player:SetAttribute("Ragdolled", false)

	humanoid.Died:Connect(function()
		Ragdoll.enable(character)
	end)

	-- ragdoll automatico por impactos fuertes
	local last = root.AssemblyLinearVelocity
	local conn
	conn = RunService.Heartbeat:Connect(function()
		if not character.Parent or humanoid.Health <= 0 then
			conn:Disconnect()
			return
		end

		local current = root.AssemblyLinearVelocity
		local delta = (current - last).Magnitude
		last = current

		if delta >= Config.ImpactThreshold and not Ragdoll.isRagdolled(character) then
			local seconds = math.clamp(delta / Config.ImpactThreshold * 1.5, 1.5, 5)
			Ragdoll.ragdollFor(character, seconds)
		end
	end)
end

local function onPlayer(player)
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
end

Players.PlayerAdded:Connect(onPlayer)
for _, player in ipairs(Players:GetPlayers()) do
	onPlayer(player)
end

Players.PlayerRemoving:Connect(function(player)
	lastToggle[player] = nil
end)

toggleEvent.OnServerEvent:Connect(function(player)
	local now = os.clock()
	if lastToggle[player] and now - lastToggle[player] < 0.5 then
		return
	end
	lastToggle[player] = now

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end

	if Ragdoll.isRagdolled(character) then
		Ragdoll.disable(character)
	else
		Ragdoll.enable(character)
	end
end)
]]></ProtectedString>
</Properties></Item>
<Item class="Script" referent="RBX196"><Properties>
<string name="Name">PhysicsProps</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Ragdoll = require(script.Parent:WaitForChild("RagdollService"))

local interactive = workspace:WaitForChild("Interactive")
local props = workspace:WaitForChild("Props")
local dummies = workspace:WaitForChild("Dummies")
local wall = workspace:WaitForChild("Wall")

-- ===== registro de posiciones iniciales =====
local home = {}
for _, container in ipairs({props, dummies, wall}) do
	for _, d in ipairs(container:GetDescendants()) do
		if d:IsA("BasePart") then
			home[d] = {cframe = d.CFrame, anchored = d.Anchored}
		end
	end
end

local function thaw(model)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = false
		end
	end
end

local function getPlayer(hit)
	local character = hit:FindFirstAncestorOfClass("Model")
	local player = character and Players:GetPlayerFromCharacter(character)
	return player, character
end

-- ===== los dummies se "descongelan" al ser tocados =====
for _, model in ipairs(dummies:GetChildren()) do
	for _, part in ipairs(model:GetChildren()) do
		if part:IsA("BasePart") then
			part.Touched:Connect(function(hit)
				if hit:IsDescendantOf(model) then return end
				if part.Anchored and (not hit.Anchored or getPlayer(hit)) then
					thaw(model)
				end
			end)
		end
	end
end

-- ===== barra giratoria =====
local spinBar = interactive:WaitForChild("SpinBar")
local speed = 2
spinBar.AssemblyAngularVelocity = Vector3.new(0, speed, 0)
RunService.Heartbeat:Connect(function(dt)
	spinBar.CFrame *= CFrame.Angles(0, speed * dt, 0)
end)

-- ===== lanzador =====
local launcher = interactive:WaitForChild("Launcher")
local cooldown = {}

launcher.Touched:Connect(function(hit)
	local player, character = getPlayer(hit)
	if not player or cooldown[player] then return end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then return end

	cooldown[player] = true
	Ragdoll.ragdollFor(character, 4)

	pcall(function() root:SetNetworkOwner(nil) end)
	root.AssemblyLinearVelocity = launcher.CFrame.LookVector * 70 + Vector3.new(0, 90, 0)
	root.AssemblyAngularVelocity = Vector3.new(math.random(-8, 8), math.random(-8, 8), math.random(-8, 8))
	task.delay(0.3, function()
		if root.Parent then
			pcall(function() root:SetNetworkOwner(player) end)
		end
	end)

	task.delay(1.5, function()
		cooldown[player] = nil
	end)
end)

-- ===== boton: soltar la bola =====
local ball = props:WaitForChild("BowlingBall")
interactive:WaitForChild("RollButton").ClickDetector.MouseClick:Connect(function()
	ball.Anchored = false
	ball.AssemblyLinearVelocity = Vector3.new(0, 0, 5)
end)

-- ===== boton: bomba =====
local bombSite = interactive:WaitForChild("BombSite")
interactive:WaitForChild("BombButton").ClickDetector.MouseClick:Connect(function()
	local explosion = Instance.new("Explosion")
	explosion.Position = bombSite.Position
	explosion.BlastRadius = 24
	explosion.BlastPressure = 600000
	explosion.DestroyJointRadiusPercent = 0

	explosion.Hit:Connect(function(part)
		local dummyModel = part:FindFirstAncestorOfClass("Model")
		if dummyModel and dummyModel.Parent == dummies then
			thaw(dummyModel)
			return
		end
		local player, character = getPlayer(part)
		if player and not Ragdoll.isRagdolled(character) then
			Ragdoll.ragdollFor(character, 4)
		end
	end)

	explosion.Parent = workspace
end)

-- ===== boton: reiniciar escena =====
interactive:WaitForChild("ResetButton").ClickDetector.MouseClick:Connect(function()
	for part, info in pairs(home) do
		if part.Parent then
			part.Anchored = true
			part.AssemblyLinearVelocity = Vector3.zero
			part.AssemblyAngularVelocity = Vector3.zero
			part.CFrame = info.cframe
		end
	end
	task.wait(0.2)
	for part, info in pairs(home) do
		if part.Parent then
			part.Anchored = info.anchored
		end
	end
end)

print("Ragdoll Playground listo")
]]></ProtectedString>
</Properties></Item>
</Item>
<Item class="StarterPlayer" referent="RBX197"><Properties>
<string name="Name">StarterPlayer</string>
</Properties>
<Item class="StarterPlayerScripts" referent="RBX198"><Properties>
<string name="Name">StarterPlayerScripts</string>
</Properties><Item class="LocalScript" referent="RBX199"><Properties>
<string name="Name">RagdollClient</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local toggleEvent = ReplicatedStorage:WaitForChild("ToggleRagdoll")
local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "RagdollHUD"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local label = Instance.new("TextLabel")
label.Size = UDim2.new(0, 300, 0, 44)
label.Position = UDim2.new(0, 12, 1, -56)
label.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
label.BackgroundTransparency = 0.3
label.TextColor3 = Color3.fromRGB(255, 255, 255)
label.Font = Enum.Font.GothamBold
label.TextSize = 18
label.Parent = gui

local function refresh()
	local on = player:GetAttribute("Ragdolled") == true
	label.Text = on and "[R] Ragdoll: ACTIVO" or "[R] Ragdoll: apagado"
	label.TextColor3 = on and Color3.fromRGB(255, 120, 80) or Color3.fromRGB(180, 255, 180)

	-- el cliente controla su propio Humanoid, asi que fija el estado aqui tambien
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		if on then
			humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		else
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end
end

player:GetAttributeChangedSignal("Ragdolled"):Connect(refresh)
refresh()

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.KeyCode == Enum.KeyCode.R then
		toggleEvent:FireServer()
	end
end)
]]></ProtectedString>
</Properties></Item></Item>
</Item>
